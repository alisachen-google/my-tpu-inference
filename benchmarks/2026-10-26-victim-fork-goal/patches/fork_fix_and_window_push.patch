+class TestPrefillPusherLockstep(LockstepCase):
+    """Acks, push outcomes and send failures reach ranks at different times;
+    the pushers must still run identical collectives and settle every push."""
+
+    def test_divergent_acks_push_outcomes_and_send_failures(self):
+        fx = [_pusher_fixture() for _ in range(WORLD)]
+        landing = list(range(8))
+
+        def body(rank, ls):
+            f = fx[rank]
+            pusher = victim_push.PrefillPusher(f.puller)
+            for room, tokens in ((1, f.a), (2, f.b)):
+                pusher.record(SimpleNamespace(bootstrap_room=room, origin_input_ids=tokens))
+            f.cache.evict(EvictParams(num_tokens=16))  # both sessions host-only
+            host = f.cache.cache_controller.host
+            if rank == 2:  # this rank's RAM-to-RAM push fails
+                host.transfer.push_host_pages.side_effect = RuntimeError("peer refused")
+            if rank == 3:  # this rank's offer never leaves (ZMQ failure)
+                f.mgr.send_victim_push.return_value = False
+            pusher.step()  # step 1: every rank starts the first push
+            self.assertEqual(len(pusher._pushes), 1)
+            first = next(iter(pusher._pushes))
+            for step in range(2, 10):
+                if step == 2 and rank in (0, 1):  # the ack reaches two ranks first
+                    f.acks[first] = VictimAck(seq=first, stored=True, landing=landing, address="10.0.0.5:9000")
+                if step == 4 and rank in (2, 3):
+                    f.acks[first] = VictimAck(seq=first, stored=True, landing=landing, address="10.0.0.5:9000")
+                for push in list(pusher._pushes.values()):
+                    if push.thread is not None:
+                        push.thread.join(2)
+                pusher.step()
+                time.sleep(0.01)
+            self.assertNotIn(first, pusher._pushes, "the first push never settled")
+            f.stats = dict(pusher.stats)
+
+        ls, errors, alive = run_ranks(WORLD, body)
+        trace = self.assert_lockstep(ls, errors, alive)
+        self.assertGreater(len(trace), 10)
+        # One rank's failed push fails the push on every rank: declined everywhere.
+        self.assertEqual({f.stats["declined"] for f in fx}, {1})
+        self.assertEqual({f.stats["stored"] for f in fx}, {0})
+

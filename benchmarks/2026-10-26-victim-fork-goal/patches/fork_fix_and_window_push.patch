+                ls.reduce([[rank, 10 - rank]], dist.ReduceOp.MAX),
+                ls.common([rank, 7, 8]),
+            )
+
+        ls, errors, alive = run_ranks(3, body)
+        self.assert_lockstep(ls, errors, alive)
+        self.assertEqual(seen[2], ([[0, 8]], [[2, 10]], [7, 8]))

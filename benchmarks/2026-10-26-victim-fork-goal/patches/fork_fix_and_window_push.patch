+class TestDecodeReceiverLockstep(LockstepCase):
+    """Pushes and done notices reach ranks in different rounds and one rank's
+    host pool is too small; the receivers must still agree on every landing."""
+
+    def test_divergent_pushes_host_room_and_dones(self):
+        fx = [_receiver_fixture(host_capacity=64 if r != 3 else 6) for r in range(WORLD)]
+        big = VictimPush(prefill="ab12", seq=1, ack_endpoint="tcp://p", tokens=list(range(300, 308)), blocks=list(range(8)))
+        small = VictimPush(prefill="ab12", seq=2, ack_endpoint="tcp://p", tokens=list(range(400, 404)), blocks=list(range(4)))
+
+        def body(rank, ls):
+            f = fx[rank]
+            receiver = victim_push.DecodeReceiver(queue=f.queue, mgr=f.mgr)
+
+            def round_(n):
+                for _ in range(n * victim_push._CADENCE):
+                    receiver.step()
+
+            if rank in (0, 1):
+                f.pushes[("ab12", 1)] = big  # two ranks see the offer a round early
+            round_(1)
+            f.pushes[("ab12", 1)] = big
+            round_(1)  # every rank agrees; rank 3 cannot fit 8 pages -> refused everywhere
+            self.assertFalse(receiver.holds_pages())
+            f.pushes[("ab12", 2)] = small
+            round_(1)  # granted everywhere (fits rank 3's 6 pages)
+            self.assertTrue(receiver.holds_pages())
+            if rank == 1:
+                f.dones[("ab12", 2)] = VictimDone(prefill="ab12", seq=2, ok=True)
+            round_(1)  # one rank's done notice is not enough
+            self.assertTrue(receiver.holds_pages())
+            f.dones[("ab12", 2)] = VictimDone(prefill="ab12", seq=2, ok=True)
+            round_(1)  # all agree: inserted on every rank
+            self.assertFalse(receiver.holds_pages())
+            f.stats = dict(receiver.stats)
+
+        ls, errors, alive = run_ranks(WORLD, body)
+        self.assert_lockstep(ls, errors, alive)
+        self.assertEqual({f.stats["no_room"] for f in fx}, {1})
+        self.assertEqual({f.stats["landed"] for f in fx}, {1})
+

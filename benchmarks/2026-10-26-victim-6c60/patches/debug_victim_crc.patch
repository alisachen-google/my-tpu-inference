+def _debug_crc(pool: Any, page_ids: Sequence[int]) -> Tuple[int, int]:
+    """CRC32 over every layer of the given host pages (debug: SGLANG_TPU_DEBUG_VICTIM_CRC)."""
+    import zlib
+
+    mgr = pool.transfer._mgr
+    crc = 0
+    n = 0
+    for layer in range(pool.transfer.layer_num):
+        for page in page_ids:
+            data = mgr.read_block_bytes(layer, int(page))
+            crc = zlib.crc32(data, crc)
+            n += len(data)
+    return crc, n
+
+
+def _debug_crc_on() -> bool:
+    return os.environ.get("SGLANG_TPU_DEBUG_VICTIM_CRC") == "1"
+
